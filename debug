#!/usr/bin/env bash
# Debug one of the course's x86-64 Linux NASM programs.
#
#     ./debug "lectures code /code-0003.asm" 1 2 3
#
# Opens a split screen: registers on top, your source below. Type `si` to step
# one instruction, then just press Enter to keep stepping. `q` quits.
set -euo pipefail

if [ $# -lt 1 ]; then
	echo "usage: $(basename "$0") file.asm [args...]" >&2
	exit 1
fi

src="$1"; shift
dir="$(cd "$(dirname "$src")" && pwd)"
base="$(basename "$src" .asm)"

docker run --rm -it -v "$dir:/work" -w /work asm-course \
	bash -c 'set -e
		prog="$1"; shift

		nasm -f elf64 -g -F dwarf "$prog.asm" -o "$prog.o"
		if grep -qE "^[[:space:]]*global[[:space:]]+_start" "$prog.asm"; then
			x86_64-linux-gnu-ld -z noexecstack -o "$prog" "$prog.o"
			entry=_start
		else
			if [ -f "${prog}_test.c" ]; then
				x86_64-linux-gnu-gcc -no-pie -g -Wl,-z,noexecstack \
					-o "$prog" "${prog}_test.c" "$prog.o" -lm
			else
				x86_64-linux-gnu-gcc -no-pie -Wl,-z,noexecstack \
					-o "$prog" "$prog.o" -lm
			fi
			entry=main
		fi

		cat > /tmp/asmrc.gdb <<GDBRC
set confirm off
set pagination off
set disassembly-flavor intel
set architecture i386:x86-64

define regs
info registers rax rbx rcx rdx rsi rdi rbp rsp
end

define vis
tui enable
layout split
tui reg general
focus cmd
end

define cheat
echo \\n
echo   si        step ONE instruction (goes into a call)\\n
echo   ni        step one instruction (steps over a call)\\n
echo   ENTER     repeat the last command\\n
echo   finish    run this function to its end\\n
echo   c         continue to the next breakpoint\\n
echo   q         quit\\n
echo \\n
echo   regs           the main registers\\n
echo   p \\\$rax         one register  (p/x hex, p/t binary)\\n
echo   x/s \\\$rdi       the string a pointer points at\\n
echo   x/8gx \\\$rsp     8 quadwords of stack\\n
echo   bt             who called whom\\n
echo \\n
echo   break printf         stop when printf is called\\n
echo   break $prog.asm:57   stop at line 57\\n
echo   vis                  split screen on (Ctrl-X then A = off)\\n
echo \\n
end

file ./$prog
target remote :1234
break $entry
continue

echo \\n
echo  ==================================================\\n
echo    si      step ONE instruction   <-- the main one\\n
echo    ENTER   repeat it (just keep pressing Enter)\\n
echo    q       quit           cheat   more commands\\n
echo  ==================================================\\n
echo \\n

# The split screen goes LAST: if the terminal cannot do it, only this is
# lost, not the banner above.
vis
GDBRC

		qemu-x86_64 -L /usr/x86_64-linux-gnu -g 1234 "./$prog" "$@" &
		sleep 0.7
		exec gdb-multiarch -q -x /tmp/asmrc.gdb' _ "$base" "$@"
